# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to \`.env\`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# For local database URL is used to connect to your Supabase database.

# DB Connection string
## Supabase example (values can be found in your console): "postgresql://postgres.[secret_id]:[secret_password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?schema=paratus"
## Local example "postgresql://postgres:postgres@localhost:5432/postgres?schema=paratus" 
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=paratus"

# Auth settings
## You can generate the secret via 'openssl rand -base64 32' on Unix
AUTH_SECRET='supersecret'

## Auth Providers
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

## Set this to the URL of your production instance, e.g. "https://paratus.illizen.com"
PRODUCTION_URL="https://paratus.illizen.com"