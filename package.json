{
	"name": "paratus-monorepo",
	"private": true,
	"engines": {
		"node": ">=22.14.0",
		"pnpm": ">=10.11.1"
	},
	"packageManager": "pnpm@10.11.1",
	"scripts": {
		"build": "pnpm -r run build",
		"build:web": "pnpm --filter paratus-web run build",
		"build:mobile": "pnpm --filter paratus-mobile run build",
		"clean": "pnpm -r run clean",
		"dev": "pnpm -r run dev",
		"dev:web": "pnpm --filter paratus-web run dev",
		"dev:mobile": "pnpm --filter paratus-mobile run dev"
	},
	"devDependencies": {
		"@paratus/prettier-config": "workspace:*",
		"prettier": "catalog:",
		"typescript": "catalog:"
	},
	"prettier": "@paratus/prettier-config"
}
